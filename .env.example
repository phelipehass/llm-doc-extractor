# Any OpenAI-compatible endpoint works. Defaults target Groq's free tier.
# Get a key at https://console.groq.com/keys and check model ids at https://console.groq.com/docs/models
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# USD per 1M tokens, used only for the cost estimate in responses (0 on the free tier).
LLM_PRICE_IN_PER_M=0
LLM_PRICE_OUT_PER_M=0

MAX_UPLOAD_BYTES=10485760
